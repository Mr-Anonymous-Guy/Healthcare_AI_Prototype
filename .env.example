# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Prisma) ───────────────────────────────────────────────
# Transaction pooler (port 6543, ?pgbouncer=true)
DATABASE_URL=
# Session pooler / direct connection (port 5432)
DIRECT_URL=

# ─── AI / LLM ───────────────────────────────────────────────────────
# OpenRouter key (recommended) — falls back to OPENAI_API_KEY
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ─── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=

# ─── App ─────────────────────────────────────────────────────────────
# Used for auth redirect URLs and HTTP-Referer headers
SITE_URL=https://healthcare-ai-nu.vercel.app
# Next.js built-in
NODE_ENV=development
